\@writefile{toc}{\contentsline {paragraph}{Trunk pipeline.}{5}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Policy network data flow (continuous action). Planet rows are projected, then mixed by one \textbf  {masked cross-planet self-attention} block (pre-LayerNorm; \texttt  {entity\_mask} hides padding planets) --- the only cross-row step, and what enables targeted aiming. The result passes through the shared per-row trunk: variant A inserts one residual GLU block (Fig.~\ref {fig:glu}) before the $n_{\mathrm  {res}}$ \emph  {pre-LayerNorm} residual MLP blocks (variant B: MLP blocks only), then a final LayerNorm. The $G$ board globals are embedded separately ($g'$, dim $d_g$) and broadcast to the heads. A two-layer \textbf  {MLP} mean head maps $[h_e;g']$ to the $3K$ means $\mu _e$; the $3K$ log-stds $\varsigma _e$ come from \emph  {either} a second head (state-dependent) \emph  {or} a shared learnable vector (state-independent) --- a switchable A/B. They define a squashed Gaussian (Section~\ref {sec:dist}), optionally \texttt  {action\_mask}ed to owned slots, whose samples are the $K$ fleet triples $(d^x,d^y,\phi )$ for planet $e$. No pooling, no value or pointer head.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{6}{Policy network data flow (continuous action). Planet rows are projected, then mixed by one \textbf {masked cross-planet self-attention} block (pre-LayerNorm; \texttt {entity\_mask} hides padding planets) --- the only cross-row step, and what enables targeted aiming. The result passes through the shared per-row trunk: variant A inserts one residual GLU block (Fig.~\ref {fig:glu}) before the $n_{\mathrm {res}}$ \emph {pre-LayerNorm} residual MLP blocks (variant B: MLP blocks only), then a final LayerNorm. The $G$ board globals are embedded separately ($g'$, dim $d_g$) and broadcast to the heads. A two-layer \textbf {MLP} mean head maps $[h_e;g']$ to the $3K$ means $\mu _e$; the $3K$ log-stds $\varsigma _e$ come from \emph {either} a second head (state-dependent) \emph {or} a shared learnable vector (state-independent) --- a switchable A/B. They define a squashed Gaussian (Section~\ref {sec:dist}), optionally \texttt {action\_mask}ed to owned slots, whose samples are the $K$ fleet triples $(d^x,d^y,\phi )$ for planet $e$. No pooling, no value or pointer head}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Residual GLU block.}{6}{section*.11}\protected@file@percent }
\newlabel{eq:glu}{{7}{6}{Residual GLU block}{equation.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The residual GLU block $\mathcal  {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:glu}{{2}{6}{The residual GLU block $\mathcal {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack}{figure.2}{}}
