\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The residual GLU block $\mathcal  {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:glu}{{2}{8}{The residual GLU block $\mathcal {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack}{figure.2}{}}
