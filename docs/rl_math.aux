\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Policy network data flow (target mode). Each encoder is a two-layer MLP followed by a residual GLU block (Fig.~\ref {fig:glu}). The masked mean-pool of the entity tokens $h_e$, concatenated with the globals $g$, gives the board context $c$; the pointer actor scores every (launcher $e$, target $t$, fraction $f$) from $h_e$ and $c$ (plus a per-launcher no-op), producing the $E\times A$ logits, which are then legality-masked.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{3}{Policy network data flow (target mode). Each encoder is a two-layer MLP followed by a residual GLU block (Fig.~\ref {fig:glu}). The masked mean-pool of the entity tokens $h_e$, concatenated with the globals $g$, gives the board context $c$; the pointer actor scores every (launcher $e$, target $t$, fraction $f$) from $h_e$ and $c$ (plus a per-launcher no-op), producing the $E\times A$ logits, which are then legality-masked}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Residual GLU block.}{3}{section*.5}\protected@file@percent }
