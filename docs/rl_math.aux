\@writefile{toc}{\contentsline {paragraph}{Single-stream trunk (the two variants under comparison).}{4}{section*.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Policy network data flow (continuous action). Each planet row (body $+$ incoming-threat features) is projected and passed through the shared per-row trunk: variant A inserts one residual GLU block (Fig.~\ref {fig:glu}) before the $n_{\mathrm  {res}}$ residual MLP blocks; variant B uses residual MLP blocks only. The $G$ board globals are embedded separately ($g'$, dim $d_g$) and broadcast to the heads. A mean head maps $[h_e;g']$ to the $2K$ means $\mu _e$; the $2K$ log-stds $\varsigma _e$ come from \emph  {either} a second head (state-dependent) \emph  {or} a shared learnable vector (state-independent) --- a switchable A/B. Together they define a squashed Gaussian (Section~\ref {sec:dist}) whose samples are the $K$ fleet pairs $(\theta ,\phi )$ for planet $e$. No pooling, no cross-row mixing, no value or pointer head.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{4}{Policy network data flow (continuous action). Each planet row (body $+$ incoming-threat features) is projected and passed through the shared per-row trunk: variant A inserts one residual GLU block (Fig.~\ref {fig:glu}) before the $n_{\mathrm {res}}$ residual MLP blocks; variant B uses residual MLP blocks only. The $G$ board globals are embedded separately ($g'$, dim $d_g$) and broadcast to the heads. A mean head maps $[h_e;g']$ to the $2K$ means $\mu _e$; the $2K$ log-stds $\varsigma _e$ come from \emph {either} a second head (state-dependent) \emph {or} a shared learnable vector (state-independent) --- a switchable A/B. Together they define a squashed Gaussian (Section~\ref {sec:dist}) whose samples are the $K$ fleet pairs $(\theta ,\phi )$ for planet $e$. No pooling, no cross-row mixing, no value or pointer head}{figure.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Residual GLU block.}{5}{section*.8}\protected@file@percent }
\newlabel{eq:glu}{{6}{5}{Residual GLU block}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The residual GLU block $\mathcal  {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:glu}{{2}{5}{The residual GLU block $\mathcal {B}$ (Eq.~\ref {eq:glu}): a value branch $W_v z$ and a sigmoid gate $\sigma (W_g z)$ are multiplied elementwise ($\odot $), projected by $W_o$, and added back to the input (the residual skip). In trunk variant A one such block (its own $d\times d$ weights) follows the input projection, before the residual MLP stack}{figure.2}{}}
